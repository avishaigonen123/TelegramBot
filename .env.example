API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+972500000000

# Comma-separated, tried in order until one succeeds
OPENROUTER_API_KEYS=sk-or-v1-xxxxx,sk-or-v1-yyyyy

# Optional: ping this URL (e.g. from healthchecks.io) after each successful tick
HEALTHCHECK_URL=

# Optional: used by keep_server_alive/ to reset the webhostmost suspension timer
WEBHOSTMOST_EMAIL=
WEBHOSTMOST_PASSWORD=
